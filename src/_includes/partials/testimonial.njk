<article class="testimonial reveal">
  <div class="testimonial-rating" aria-label="{{ tt.ui.ratingLabel }}">★★★★★</div>
  <p class="testimonial-text">{{ tm.text }}</p>
  <footer class="testimonial-footer">
    <div class="author-avatar" aria-hidden="true">{{ tm.initials }}</div>
    <div class="author-info">
      <p class="author-name">{{ tm.name }} <span class="author-verified" title="{{ tt.ui.verifiedTitle }}" aria-label="{{ tt.ui.verified }}">✓</span></p>
      <p class="author-role">{{ tm.role }} · <span class="author-company">{{ tm.company }}</span></p>
    </div>
  </footer>
</article>
