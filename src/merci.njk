---
layout: base.njk
pageKey: merci
slug: "merci"
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "{{ lang | locPath(slug) }}index.html"
---
{% set tt = t[lang] %}
{% set m = tt.merci %}
<main id="main" tabindex="-1">
  <section class="hero" style="text-align: center; min-height: calc(100vh - var(--header-h));">
    <div class="container" style="max-width: 640px;">
      <div style="width:90px; height:90px; border-radius:50%; background: var(--gradient); margin: 0 auto 30px; display:grid; place-items:center; font-size:2.6rem; box-shadow: var(--shadow-glow);">✓</div>
      <span class="section-tag">{{ m.tag }}</span>
      <h1>{{ m.titleHtml | safe }}</h1>
      <p class="hero-sub">{{ m.sub }}</p>
      <div class="hero-cta">
        <a href="{{ site.whatsapp }}" class="btn btn-primary btn-lg">{{ m.btnWa }}</a>
        <a href="{{ lang | locPath('') }}" class="btn btn-ghost btn-lg">{{ m.btnHome }}</a>
      </div>
    </div>
  </section>
</main>
